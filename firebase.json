{
  "hosting": {
    "site": "restavia",
    "public": "deploy",
    "ignore": ["**/.*", "!.well-known/**"],
    "cleanUrls": false,
    "redirects": [
      { "source": "/deploy", "destination": "/", "type": 301 },
      { "source": "/deploy/:path*", "destination": "/:path", "type": 301 }
    ],
    "headers": [
      {
        "source": "**/*.@(html|json|js)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
          { "key": "Service-Worker-Allowed", "value": "/" }
        ]
      },
      {
        "source": "**/*.@(png|svg|jpg|webp|mp3|m4a|ogg)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      }
    ]
  }
}
